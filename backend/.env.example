# Copy this file to .env, then set paths for your machine or Google Drive mount.
MODEL_PATH=model/ConvLSTM_JanFebMar_Prototype.keras
MODEL_VERSION=prototype-v1
SST_DATA_DIR=data/SST
SSH_DATA_DIR=data/SSH
PREPROCESSING_STATS_PATH=preprocessing_artifacts/preprocessing_stats.npz

# Comma-separated origins; * is convenient for local development.
ALLOW_ORIGINS=*

# Change these after training a future model. Blank SUPPORTED_TARGET_MONTHS means
# the API permits any valid month whose required input files exist.
TEMPORAL_WINDOW_MONTHS=3
SUPPORTED_TARGET_MONTHS=2020-03
