# Copy this file to .env, then fill in paths and secrets.
MODEL_PATH=model/ConvLSTM_JanFebMar_Prototype.keras
MODEL_VERSION=prototype-v1
SST_DATA_DIR=data/SST
SSH_DATA_DIR=data/SSH
PREPROCESSING_STATS_PATH=preprocessing_artifacts/preprocessing_stats.npz

# Comma-separated origins; * is fine for local development.
ALLOW_ORIGINS=*

# Change after training a future model.
TEMPORAL_WINDOW_MONTHS=3
SUPPORTED_TARGET_MONTHS=2020-03

# Alarm polling interval in seconds (default: 2.0)
ALARM_POLL_INTERVAL_SECONDS=2.0

# Telegram notifications
# Create a bot via @BotFather to get the token.
# To get your chat_id: message @userinfobot or send /subscribe to your bot after startup.
#
# TELEGRAM_CHAT_IDS is the seed list — comma-separated chat_ids that are
# pre-subscribed at startup. More recipients can subscribe at runtime by
# sending /subscribe to the bot. Leave blank to start with no recipients.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
